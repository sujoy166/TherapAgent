# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Reactome / data caches (downloaded on demand by phase 02 scripts)
binn/cache/
graphpath/cache/
path/cache/

# Generated binary artifacts (per-cohort subdirectories). The LaTeX tables
# in tex/ ARE tracked so the paper can render without retraining.
binn/artifacts/*/*.pkl
binn/artifacts/*/*.npz
binn/artifacts/*/*.pt
binn/artifacts/*/results.json
graphpath/artifacts/*/*.pkl
graphpath/artifacts/*/*.npz
graphpath/artifacts/*/*.pt
graphpath/artifacts/*/results.json
path/artifacts/*/*.pkl
path/artifacts/*/*.npz
path/artifacts/*/*.pt
path/artifacts/*/results.json

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Mac OS
.DS_Store

# Local zip templates (e.g. the IEEE template archive)
*.zip
